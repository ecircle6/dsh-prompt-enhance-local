{
  "name": "dsh-prompt-enhance-local",
  "version": "0.2.0",
  "description": "本地加固 fork（源自 zzy6-a/dsh-prompt-enhance，MIT）：输入框旁一键把口语草稿改写成结构化专业提示词，可撤销；五种风格、模型可跟随或固定、芯片置灰保护；零文件写入、严格 Origin 校验、内置限流。",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecircle6/dsh-prompt-enhance-local.git"
  },
  "homepage": "https://github.com/ecircle6/dsh-prompt-enhance-local",
  "bugs": {
    "url": "https://github.com/ecircle6/dsh-prompt-enhance-local/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "prompt",
    "prompt-engineering",
    "composer",
    "ux"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "bash scripts/build.sh && npm run build:client",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "prepack": "npm run build && npm test"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18 <4"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^24.13.3",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
